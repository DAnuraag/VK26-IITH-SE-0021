{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arka:reference:telemetry:1.0",
  "title": "ARKA reference telemetry envelope",
  "description": "Reference contract, not a published implementation schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_type",
    "source",
    "time",
    "measurements",
    "quality",
    "calibration_id",
    "firmware_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_type": {
      "const": "telemetry"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "zone_id",
        "node_id",
        "boot_id",
        "seq"
      ],
      "properties": {
        "site_id": {
          "$ref": "#/$defs/identifier"
        },
        "zone_id": {
          "$ref": "#/$defs/identifier"
        },
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "boot_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_utc",
        "uptime_ms",
        "clock_status"
      ],
      "properties": {
        "source_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clock_status": {
          "enum": [
            "synced",
            "uncertain",
            "unsynced"
          ]
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voltage_v",
        "current_a",
        "irradiance_w_m2",
        "panel_temperature_c"
      ],
      "properties": {
        "voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 36
        },
        "current_a": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -5,
          "maximum": 5
        },
        "irradiance_w_m2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2000
        },
        "panel_temperature_c": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -55,
          "maximum": 125
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_status"
      ],
      "properties": {
        "channel_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voltage",
            "current",
            "irradiance",
            "panel_temperature"
          ],
          "properties": {
            "voltage": {
              "$ref": "#/$defs/channelStatus"
            },
            "current": {
              "$ref": "#/$defs/channelStatus"
            },
            "irradiance": {
              "$ref": "#/$defs/channelStatus"
            },
            "panel_temperature": {
              "$ref": "#/$defs/channelStatus"
            }
          }
        }
      }
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "firmware_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "channelStatus": {
      "enum": [
        "valid",
        "invalid",
        "missing",
        "uncertain",
        "out_of_range"
      ]
    }
  }
}
